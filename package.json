{
  "name": "uk-credit-cards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"public/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"public/**/*.json\"",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
